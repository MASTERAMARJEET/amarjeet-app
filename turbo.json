{
  "$schema": "https://turbo.build/schema.json",
  "ui": "tui",
  "tasks": {
    "deploy": {
      "dependsOn": ["^deploy", "build"]
    },
    "deploy:prod": {
      "dependsOn": ["^deploy:prod", "build"]
    },
    "build": {
      "dependsOn": ["^build", "check-types"],
      "outputs": ["dist/**"]
    },
    "typegen": {
      "dependsOn": ["^typegen"],
      "inputs": ["$TURBO_ROOT$/apps/api/wrangler.toml", "$TURBO_ROOT$/apps/web/wrangler.toml"]
    },
    "check-types": {
      "dependsOn": ["^check-types", "typegen"]
    },
    "format": {
      "dependsOn": ["^format"]
    },
    "clean": {
      "dependsOn": ["^clean"]
    },
    "dev": {
      "persistent": true,
      "cache": false
    }
  }
}
